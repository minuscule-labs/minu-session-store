{
  "name": "@minuscule-labs/session-store",
  "version": "0.1.0",
  "description": "Local-first immutable archive and SQLite catalog for coding-agent sessions",
  "license": "Apache-2.0",
  "author": "Minuscule Labs",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/minuscule-labs/minu-session-store.git"
  },
  "homepage": "https://github.com/minuscule-labs/minu-session-store#readme",
  "bugs": {
    "url": "https://github.com/minuscule-labs/minu-session-store/issues"
  },
  "keywords": [
    "coding-agent",
    "pi",
    "session-archive",
    "sqlite",
    "s3"
  ],
  "private": true,
  "files": [
    "dist",
    "docs",
    "drizzle",
    "CHANGELOG.md",
    "LICENSE",
    "README.md"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "minu-sessions": "./dist/cli.js"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepack": "npm run build",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "audit:prod": "npm audit --omit=dev",
    "verify": "npm run check && npm test && npm run build && npm run audit:prod",
    "db:generate": "drizzle-kit generate",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1121.0",
    "@aws-sdk/client-sts": "^3.1121.0",
    "@aws-sdk/credential-providers": "^3.1121.0",
    "@libsql/client": "^0.17.4",
    "drizzle-orm": "^0.45.2"
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "drizzle-kit": "^0.31.10",
    "tsx": "^4.23.12",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  }
}
